#include <windows.h>
1 VERSIONINFO
FILEVERSION @resource_version_csv@,0
PRODUCTVERSION @resource_version_csv@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "libexif"
            VALUE "FileVersion", "@resource_version@.0"
            VALUE "ProductName", "libexif"
            VALUE "ProductVersion", "@resource_version@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
